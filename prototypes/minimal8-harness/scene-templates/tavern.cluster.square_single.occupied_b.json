{
  "template_id": "tavern.cluster.square_single.occupied_b",
  "description": "Quiet side table with a single bottle and one empty chair.",
  "parameters": {
    "architecture_layer": {
      "type": "str",
      "required": false,
      "description": "Layer for furniture stamps."
    },
    "ornament_layer": {
      "type": "str",
      "required": false,
      "description": "Layer for drink and prop overlays."
    },
    "actors_layer": {
      "type": "str",
      "required": false,
      "description": "Layer for actor stamps."
    }
  },
  "bindings": {
    "architecture_layer": {
      "param": "architecture_layer",
      "default": "architecture"
    },
    "ornament_layer": {
      "param": "ornament_layer",
      "default": "ornament"
    },
    "actors_layer": {
      "param": "actors_layer",
      "default": "actors"
    }
  },
  "ops": [
    {
      "kind": "entity",
      "layer": {
        "bind": "architecture_layer"
      },
      "construction": "indoors.table.kit.square_single",
      "x": 0,
      "y": 0
    },
    {
      "kind": "stamp",
      "layer": {
        "bind": "architecture_layer"
      },
      "ref": "indoors.chair.left",
      "x": 1,
      "y": 0
    },
    {
      "kind": "stamp",
      "layer": {
        "bind": "ornament_layer"
      },
      "ref": {
        "ref": "prop.bottle.potion.purple",
        "underpaint": "indoors.table.square",
        "occlusion": "fill_holes",
        "offset_left": 1,
        "offset_bottom": 1
      },
      "x": 0,
      "y": 0
    }
  ]
}
