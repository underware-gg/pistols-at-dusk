    "base_floor": {
      "param": "base_floor",
      "default": "tavern.floor.quiet.base"
    },
    "quiet_floor_refs": {
      "param": "quiet_floor_refs",
      "default": [
        "tavern.floor.quiet.sparse.a",
        "tavern.floor.quiet.sparse.b",
        "tavern.floor.quiet.sparse.c"
      ]
    },
    "quiet_floor_density": {
      "param": "quiet_floor_density",
      "default": 0.03
    },
    "quiet_floor_seed": {
      "param": "quiet_floor_seed",
      "default": 13
