{
  "template_id": "tavern",
  "description": "Interior tavern room with a framed back bar, compact cellar access, mixed communal and side tables, and authored drinks and patrons.",
  "parameters": {
    "x": {
      "type": "int",
      "required": true,
      "description": "Left tile coordinate of the tavern footprint."
    },
    "y": {
      "type": "int",
      "required": true,
      "description": "Top tile coordinate of the tavern footprint."
    },
    "width": {
      "type": "int",
      "required": true,
      "description": "Tavern width in tiles."
    },
    "height": {
      "type": "int",
      "required": true,
      "description": "Tavern height in tiles."
    },
    "terrain_layer": {
      "type": "str",
      "required": false,
      "description": "Layer name for floor fills and scatter."
    },
    "architecture_layer": {
      "type": "str",
      "required": false,
      "description": "Layer name for walls, furniture, and doors."
    },
    "ornament_layer": {
      "type": "str",
      "required": false,
      "description": "Layer name for small shelf and wall overlays."
    },
    "actors_layer": {
      "type": "str",
      "required": false,
      "description": "Layer name for character stamps."
    },
    "base_floor": {
      "type": "tile_ref",
      "required": false,
      "description": "Base floor tile or pattern reference."
    },
    "quiet_floor_refs": {
      "type": "list[tile_ref]",
      "required": false,
      "description": "Tile or pattern references used for sparse floor scatter."
    },
    "quiet_floor_density": {
      "type": "float",
      "required": false,
      "description": "Scatter density for quiet floor accents."
    },
    "quiet_floor_seed": {
      "type": "int",
      "required": false,
      "description": "Random seed for the quiet floor scatter pass."
    },
    "back_wall_x": {
      "type": "int",
      "required": false,
      "description": "Explicit left tile coordinate for the back wall run."
    },
    "back_wall_width": {
      "type": "int",
      "required": false,
      "description": "Explicit width of the back wall run."
    },
    "back_wall_y": {
      "type": "int",
      "required": false,
      "description": "Explicit top tile coordinate for the back wall run."
    },
    "service_left": {
      "type": "int",
      "required": false,
      "description": "Explicit left tile coordinate for the main service counter run."
    },
    "service_right": {
      "type": "int",
      "required": false,
      "description": "Explicit right tile coordinate for the main service counter run."
    },
    "service_y": {
      "type": "int",
      "required": false,
      "description": "Explicit Y coordinate for the main service counter run."
    },
    "door_x": {
      "type": "int",
      "required": false,
      "description": "Explicit X coordinate for the grand tavern entrance door."
    },
    "warm_floor_refs": {
      "type": "list[tile_ref]",
      "required": false,
      "description": "Warmer floor accent tiles used for a light secondary scatter pass."
    },
    "warm_floor_density": {
      "type": "float",
      "required": false,
      "description": "Scatter density for warmer floor accents."
    }
  },
  "bindings": {
    "terrain_layer": {
      "param": "terrain_layer",
      "default": "terrain"
    },
    "architecture_layer": {
      "param": "architecture_layer",
      "default": "architecture"
    },
    "ornament_layer": {
