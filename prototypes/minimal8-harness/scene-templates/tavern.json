    "back_wall_x": {
      "param": "back_wall_x",
      "default": {
        "add": [
          {
            "param": "x"
          },
          10
        ]
      }
    },
    "back_wall_width": {
      "param": "back_wall_width",
      "default": {
        "min": [
          18,
          {
            "max": [
              16,
              {
                "sub": [
                  {
                    "param": "width"
                  },
                  20
                ]
              }
            ]
          }
        ]
      }
    },
    "back_wall_y": {
      "param": "back_wall_y",
