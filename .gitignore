.DS_Store
*.swp
*.swo

# brain local state
.brain/local/

# editor / IDE
.vscode/
.idea/
*.iml

# node / pnpm (in case JS pipeline lands here later)
node_modules/
.pnpm-store/

# npm lockfile — pnpm is the canonical package manager; reject accidental npm install artefacts
package-lock.json

# python virtual environment
.venv/
__pycache__/
*.pyc
.coverage
htmlcov/

# scratch areas (repo-wide or per-track)
scratch.local/

# transient prototype renders and archive snapshots
prototypes/minimal8-harness/generated/

# generated inspect-family guide artefacts (must not be committed into family dirs)
prototypes/minimal8-harness/tile-families/**/sheet_grid.png
prototypes/minimal8-harness/tile-families/**/source_layout*.png

# canary receipts (transient pre-commit log)
.canary--pre-commit

# Scratch render/crop dumps — use scratch.local/ instead
.tmp_*
.tmp/
