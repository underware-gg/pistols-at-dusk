# Defence in depth: npm is not the package manager for this repo (pnpm is),
# but if `npm install` is run accidentally these gates must still hold.
# See docs/contributor/process.md for the pnpm-side policy.

# Block postinstall / prepare / preinstall RCE from any dependency in the graph.
ignore-scripts=true

# Reject install if the running Node version does not satisfy package.json `engines`.
engine-strict=true

# Fail `npm audit` at moderate or higher severity.
audit-level=moderate

# Suppress funding messages; they obscure real warnings.
fund=false
